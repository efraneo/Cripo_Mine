# ============================================================
#  BTC MINER STUDIO — Plantilla de Secrets de Streamlit
# ============================================================
# 1) Copia este archivo como  .streamlit/secrets.toml
# 2) Rellena SOLO lo que necesites (los vacíos usan defaults)
# 3) En Streamlit Cloud: pega este mismo contenido en
#    "App → Settings → Secrets"
#
#  ⚠️  SEGURIDAD: nunca subas este archivo a GitHub con claves reales.
# ============================================================

# ---------- BINANCE (opcional: para monitoreo y dirección de depósito) ----
# Crea tu API key en: Binance → Perfil → Gestión de API
# ⚠️ Activa SOLO el permiso "Lectura" (Read). NO actives retiros.
BINANCE_API_KEY = ""
BINANCE_API_SECRET = ""

# ---------- MINERÍA --------------------------------------------------------
# Dirección BTC donde quieres recibir lo minado.
# Recomendado: la dirección de depósito BTC de tu Binance
# (la app te la muestra en la pestaña Binance y puede usarla automáticamente)
BTC_PAYOUT_ADDRESS = ""

# URL stratum del pool. Opciones probadas (ver catálogo en la app):
#   stratum+tcp://public-pool.io:21496      ← solo, lowdiff, ideal CPU (default)
#   stratum+tcp://stratum.ckpool.org:3333   ← solo.ckpool.org, sin registro
#   stratum+tcp://solo.69pool.org:3333      ← 69Pool solo público
#   stratum+tcp://kano.is:3333              ← Kano.is PPLNS
#   stratum+tcp://btc.f2pool.com:3333       ← F2Pool (cuenta)
#   stratum+tcp://btc.viabtc.io:3333        ← ViaBTC (cuenta)
#   stratum+tcp://sha256.apply.nicehash.com:3334 ← NiceHash
POOL_URL = "stratum+tcp://public-pool.io:21496"

# Usuario del pool (si vacío, la app usa BTC_PAYOUT_ADDRESS.worker_name)
POOL_USER = ""

# Contraseña del pool (en pools públicos casi siempre "x")
POOL_PASSWORD = "x"

# Nombre del worker (aparece en las estadísticas del pool)
WORKER_NAME = "cpu01"

# Modo del minero:
#   "python"   → minero stratum nativo incluido (funciona ya, sin instalar nada)
#   "bench"    → solo hashea en local (sin pool) para medir tu CPU
#   "demo"     → simulación con datos sintéticos (para ver el dashboard)
#   "external" → gestiona un binario externo tipo XMRig/cpuminer
MINER_MODE = "python"

# Ruta al binario externo (solo si MINER_MODE="external")
#   Linux ej:  /usr/bin/xmrig
#   Windows ej: C:\\miners\\xmrig.exe
EXTERNAL_MINER_PATH = ""

# Argumentos extra para el binario externo (opcional)
EXTERNAL_MINER_ARGS = ""

# Hilos de CPU para el minero Python (empieza bajo: 1-2)
CPU_THREADS = 2

# ---------- APP -------------------------------------------------------------
# Segundos entre refrescos del panel en vivo (mínimo 2)
AUTO_REFRESH_SECONDS = 5

# ---------- POOLS CON CUENTA (opcionales) -----------------------------------
# F2Pool: para consultar tus estadísticas vía API en la pestaña "Red y Pool"
F2POOL_ACCOUNT = ""

# NiceHash (api.nicehash.com → API Management)
NICEHASH_API_KEY = ""
NICEHASH_API_SECRET = ""
NICEHASH_ORG_ID = ""

# ============================================================================
# V2 — INTERVENCIÓN AGRESIVA (motor multi-pool + failover + Telegram + pagos)
# ============================================================================

# Telegram: alertas instantáneas + control remoto del minero.
# 1) Habla con @BotFather → /newbot → copia aquí el token
# 2) Envía cualquier mensaje a tu bot y usa el botón
#    "¿Cuál es mi chat_id?" del dashboard (pestaña Motor agresivo)
TELEGRAM_BOT_TOKEN = ""
TELEGRAM_CHAT_ID = ""

# Wallet Monero (necesaria para MoneroOcean y SupportXMR, los objetivos
# 2 y 3 del failover; para el objetivo 1 unMineable basta BTC_PAYOUT_ADDRESS)
WALLET_XMR = ""

# Motor agresivo: mina RandomX (donde tu CPU SÍ rinde), rota entre:
#   1) unMineable   → paga en BTC directo a tu Binance
#   2) MoneroOcean  → auto-cambio de algoritmo, paga XMR
#   3) SupportXMR   → respaldo veterano, paga XMR
# Si un pool no da shares en FAILOVER_MINUTES, salta al siguiente y te avisa.
AGGRESSIVE_MODE = true
FAILOVER_MINUTES = 12
ROTATE_MINUTES = 0

# Pausa térmica automática: si la CPU pasa de este límite, el daemon pausa
# y avisa por Telegram; reanuda solo cuando baja 8 °C.
CPU_TEMP_MAX = 85.0

# Resumen diario por Telegram (hora local 0-23)
DAILY_SUMMARY_HOUR = 20

# Balance en el pool (BTC) que dispara el aviso "payout en camino"
PAYOUT_ALERT_MIN_BTC = 0.0005
