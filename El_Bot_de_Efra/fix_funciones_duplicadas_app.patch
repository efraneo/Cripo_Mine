 # --- BLOQUE 1: Limpieza de sesión unificada ---

+def limpiar_archivo_sesion():
+    """Elimina el archivo principal de sesión si existe."""
+    try:
+        if os.path.exists(SESSION_FILE):
+            os.remove(SESSION_FILE)
+            log_info(f"Archivo de sesión eliminado: {SESSION_FILE}", archivo="app.py", funcion="limpiar_archivo_sesion")
+    except Exception as e:
+        log_error(e, archivo="app.py", funcion="limpiar_archivo_sesion")
+
+
+def limpiar_cache_sesion():
+    """Elimina el archivo de caché de sesión si existe."""
+    try:
+        if os.path.exists(SESSION_CACHE_FILE):
+            os.remove(SESSION_CACHE_FILE)
+            log_info(f"Caché de sesión eliminada: {SESSION_CACHE_FILE}", archivo="app.py", funcion="limpiar_cache_sesion")
+    except Exception as e:
+        log_error(e, archivo="app.py", funcion="limpiar_cache_sesion")
+
+
+def limpiar_sesion_completa():
+    """Elimina tanto el archivo de sesión como la caché asociada."""
+    limpiar_archivo_sesion()
+    limpiar_cache_sesion()
+
